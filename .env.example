# Copied to ~/.jervis/.env by scripts/setup.sh. Never commit the real file.

# Required (Phase 2 onward)
ANTHROPIC_API_KEY=

# Phase 4 - Gmail OAuth (from Google Cloud console; run scripts/setup-gmail.sh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 5 - Plaid. The per-item access_token lives in the macOS Keychain, not here.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Telegram - from @BotFather (/newbot). Pair it with telegram.allowed_user_ids
# in config.yaml, or Jervis will answer nobody.
TELEGRAM_BOT_TOKEN=

# Phase 3 - optional TTS backend
ELEVENLABS_API_KEY=
